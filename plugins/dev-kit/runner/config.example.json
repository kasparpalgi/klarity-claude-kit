{
	"pollSeconds": 60,
	"checkpointQuietSeconds": 60,
	"machine": "mac",
	"machineDefault": true,
	"useHerdr": true,
	"unattended": true,
	"taskMinutes": 45,
	"blockedMinutes": 30,
	"repos": {
		"klarity/svelte-hasura-boilerplate": "~/Documents/GitHub/svelte-hasura-boilerplate",
		"klarity/svelte-todo-kanban": "~/Documents/GitHub/svelte-todo-kanban"
	},
	"endpoint": "https://<your-hasura>/v1/graphql",
