{
  "name": "kanban-runner",
  "version": "0.6.1",
  "private": true,
  "description": "Watch the Kanban TODO column and run /todo in the matching repo.",
  "type": "module",
  "bin": {
    "kanban-runner": "src/run.js"
  },
  "scripts": {
    "start": "node src/run.js",
    "check": "node src/run.js --check",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  }
}